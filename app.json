{
  "expo": {
    "name": "Kebun Tugas",
    "slug": "kebun-tugas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "kebuntugas",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/app/icon.png",
      "bundleIdentifier": "com.kebuntugas.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kebuntugas.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/app/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8ee",
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#6b4eff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/gradle-abi.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6e364e9-c2c2-458a-adde-bd8bbc00a797"
      }
    },
    "owner": "p4nn"
  }
}
